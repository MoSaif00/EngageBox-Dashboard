# Clerk — use pk_live_ / sk_live_ for production (pk_test_ / sk_test_ only for local/dev)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_live_...
CLERK_SECRET_KEY=sk_live_...

# Required on Vercel *.vercel.app only. Do NOT set for local pk_test_ development.
# NEXT_PUBLIC_CLERK_PROXY_URL=https://engage-box.vercel.app/__clerk

# Keep auth on your app (avoid broken accounts.*.vercel.app Account Portal)
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/dashboard
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/dashboard

# Supabase Postgres — prefer the Transaction pooler URI (port 6543) on Vercel
DATABASE_URL=

# App + widget
NEXT_PUBLIC_BASE_URL=https://your-dashboard.vercel.app
WIDGET_URL=https://your-widget-host

# Stripe
NEXT_PUBLIC_PUBLISHABLE_KEY=pk_live_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_live_...
STRIPE_SECRET_KEY=sk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_WEBHOOK_LOCAL_SECRET=whsec_...
